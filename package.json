{
    "name": "microsoft-rewards-script",
    "version": "4.2.0",
    "description": "Automatically do tasks for Microsoft Rewards but in TS!",
    "author": "Netsky",
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "pre-build": "npm i && npx patchright install chromium && npm run build",
        "install:browser": "npx patchright install chromium",
        "build": "rimraf dist distv2 && tsc -p tsconfig.json && tsc -p tsconfig.v2.json && node ./scripts/main/copyAssets.js",
        "build:v2": "rimraf distv2 && tsc -p tsconfig.v2.json",
        "start": "node ./dist/index.js",
        "start:log": "node ./dist/index.js 2>&1 | tee logs/bot-$(date +%Y%m%d-%H%M%S).log",
        "ts-start": "ts-node ./src/index.ts",
        "dev": "ts-node ./src/index.ts -dev",
        "api": "node ./scripts/api/server.js",
        "kill-chrome-win": "powershell -Command \"Get-Process | Where-Object { $_.MainModule.FileVersionInfo.FileDescription -eq 'Google Chrome for Testing' } | ForEach-Object { Stop-Process -Id $_.Id -Force }\"",
        "create-docker": "docker build -t microsoft-rewards-script-docker .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:log-parser": "node --test scripts/api/logParser.test.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clear-diagnostics": "rimraf diagnostics",
        "clear-sessions": "node ./scripts/main/clearSessions.js",
        "open-session": "node ./scripts/main/browserSession.js -email",
        "setup-totp": "node ./dist/index.js -setup-totp",
        "setup-totp:dry": "node ./dist/index.js -setup-totp -dry",
        "test-email-code": "node ./scripts/main/testEmailCode.js"
    },
    "keywords": [
        "Bing Rewards",
        "Microsoft Rewards",
        "Bot",
        "Script",
        "TypeScript",
        "Playwright"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mailparser": "3.4.6",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.10.1",
        "@types/semver": "^7.7.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "chalk": "^4.1.2",
        "cheerio": "^1.0.0",
        "fast-xml-parser": "5.11.2",
        "fingerprint-generator": "2.1.89",
        "fingerprint-injector": "2.1.89",
        "ghost-cursor-playwright-port": "^1.4.3",
        "http-proxy-agent": "^9.1.0",
        "https-proxy-agent": "^9.1.0",
        "imapflow": "1.0.199",
        "impit": "0.14.6",
        "mailparser": "3.7.5",
        "ms": "^2.1.3",
        "otpauth": "9.5.2",
        "p-queue": "9.3.5",
        "patchright": "1.64.1",
        "semver": "7.8.5",
        "socks-proxy-agent": "^10.1.0",
        "ts-node": "^10.9.2",
        "zod": "4.6.7"
    }
}
